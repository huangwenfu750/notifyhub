# Gradle
.gradle/
build/

# 代码生成工具二进制（由 scripts/gen-protos.sh 下载）
tools/

# Node
node_modules/
dist/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# GPG 私钥导出物（发 Maven Central 用的 private-key.asc，绝不入库）
*.asc

# Go
# 注意：sdks/go/gen/ 的 grpc stub 必须入库。Go 模块是按 tag 从仓库直接取源码的，
# 不入库的话 go get 拿到的模块会缺 gen/notify/v1 包而编译失败（v0.1.0 就踩过这个坑）。
# go build 会在包目录留下可执行文件
smoke/go/*.exe
smoke/go/smoke-go

# IDE / 系统
.idea/
*.iml
.vscode/
Thumbs.db

# 本地配置（含 token / webhook 密钥，不入库；smoke/config.yaml 是测试用，保留）
/config.yaml
/packaging/docker/config.yaml

# 本地维护文档（发版流程 / 开发指南 / 项目元信息等，不随开源内容发布）
/docs/local/

# WorkBuddy 工作区数据
.workbuddy-ai/

# 运行日志
*.log

# Go 构建产物（go build 会在包目录留下可执行文件）
examples/go/*.exe
examples/go/notifyhub-example-go
sdks/go/*.exe
